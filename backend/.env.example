# ===== BoletasGP - Backend (.env) =====
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env con credenciales reales.

# Servidor / puerto de la API
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Seguridad: usa un secreto largo y aleatorio (ej. generado con openssl rand -hex 64)
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h

# Orígenes permitidos para CORS (separados por coma). Ej: https://boletas.miempresa.com
# Vacío = permite cualquier origen (solo para desarrollo).
CORS_ORIGIN=

# ===== Base de datos (SQL Server) =====
DB_HOST=IP_DEL_SERVIDOR_SQL
DB_PORT=1433
DB_USER=usuario_sql
DB_PASSWORD=clave_sql
DB_NAME=BoletaRRHH
# true crea/actualiza el esquema automáticamente (desarrollo). En producción pon false
# una vez que el esquema esté creado.
DB_SYNCHRONIZE=false

# ===== Nómina (procedimientos en la misma BD) =====
NOMINA_LINKED_SERVER=ERP_101013
NOMINA_DB=dbGP_2024_GP
NOMINA_EMP_CODIGO=003
NOMINA_ID_REMUNE=1

# ===== GGHH / ERP (sincronización de trabajadores) =====
GGHH_DB_HOST=IP_SERVIDOR_ERP
GGHH_DB_PORT=1433
GGHH_DB_USER=usuario_sql
GGHH_DB_PASSWORD=clave_sql
GGHH_DB_NAME=DB_GP_Trabajos_TEST

# ===== Usuario admin local (respaldo del login) =====
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_password_admin
ADMIN_NOMBRE=Recursos Humanos

# ===== Carpeta donde se guardan los PDF de boletas (UNC o ruta local) =====
SERVIDOR_BOLETAS=\\IP_SERVIDOR_ARCHIVOS\RUTA\BOLETAS

# ===== Correo (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=correo_remitente@dominio.com
SMTP_PASS=clave_smtp

# ===== URL pública del frontend (para los enlaces de firma/ver) =====
FRONT_URL=https://boletas.miempresa.com